@charset "UTF-8";
.links-page {
  display: grid;
  grid-template-columns: minmax(6rem, 10rem) minmax(0, 1fr) minmax(6rem, 9rem);
  align-items: start;
  gap: 0.75rem;
  min-height: 100%;
  padding: 0.5rem 0 3rem;
}

#tab-content:has(.links-page) {
  scrollbar-width: none;
}
#tab-content:has(.links-page)::-webkit-scrollbar {
  display: none;
}

.links-controls {
  position: sticky;
  top: 50%;
  align-self: start;
  max-height: 70vh;
  overflow: hidden auto;
  scrollbar-width: thin;
  scrollbar-color: #dce4d7 transparent;
  transform: translateY(-50%);
}

.links-main {
  min-width: 0;
}

.links-list {
  display: block;
}

.links-virtual-spacer {
  display: block;
}

.links-empty {
  display: grid;
  min-height: 45vh;
  place-items: center;
  margin: 0;
  padding: 2rem;
  color: #788579;
  font-size: 1rem;
  text-align: center;
}

.link-item {
  min-width: 0;
  margin-bottom: 0.7rem;
  overflow: hidden;
  border: 1px solid #dce4d7;
  border-radius: 12px;
  background: #fffefb;
  box-shadow: 0 2px 8px rgba(54, 72, 54, 0.04);
}

.link-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem 1rem;
  padding: 0.8rem 0.9rem;
  cursor: pointer;
}

.link-button {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  min-width: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #49654a;
  font: inherit;
  font-size: 0.92rem;
  font-weight: 650;
  text-align: left;
  pointer-events: none;
}

.link-label {
  min-width: 0;
  overflow-wrap: anywhere;
}

.link-chevron {
  flex: 0 0 auto;
  color: #788579;
  transition: transform 180ms ease;
  -webkit-user-select: none;
  user-select: none;
  float: right;
}

.link-item-header.expanded .link-chevron {
  transform: rotate(180deg);
}

.link-breakdown {
  display: flex;
  flex: 0 0 auto;
  gap: 0.4rem;
}

.link-stat {
  padding: 0.25rem 0.55rem;
  border: 1px solid #d8e5d2;
  border-radius: 999px;
  background: #e6eee1;
  color: #49654a;
  font-size: 0.7rem;
  font-weight: 650;
  white-space: nowrap;
}

.links-edit-list {
  display: grid;
  border-top: 1px solid #dce4d7;
}
.links-edit-list.hidden {
  display: none;
}

.links-edit-row {
  display: grid;
  grid-template-columns: minmax(11rem, 0.8fr) minmax(0, 1.2fr);
  align-items: center;
  gap: 0.55rem;
  box-sizing: border-box;
  height: 3.25rem;
  min-height: 3.25rem;
  padding: 0.25rem 0.6rem;
  border-left: 3px solid var(--user-color, #dce4d7);
  background: #fffefb;
}
.links-edit-row.even {
  background: #edf2e8;
}

.links-edit-spacer {
  grid-column: 1/-1;
}

.links-edit-meta,
.links-edit-page {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  min-width: 0;
}

.links-edit-page {
  overflow: hidden;
  font-size: 0.82rem;
  white-space: nowrap;
}

.links-edit-timestamp {
  flex: 0 0 auto;
  color: #49654a;
  font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
  text-decoration: none;
}

a.links-edit-timestamp,
a.links-edit-account,
a.links-edit-project,
a.links-edit-title {
  text-decoration: none;
}
a.links-edit-timestamp:hover,
a.links-edit-account:hover,
a.links-edit-project:hover,
a.links-edit-title:hover {
  text-decoration: underline;
}
a.links-edit-timestamp:focus-visible,
a.links-edit-account:focus-visible,
a.links-edit-project:focus-visible,
a.links-edit-title:focus-visible {
  outline: 2px solid #789b73;
  outline-offset: 2px;
  border-radius: 2px;
}

.links-edit-account {
  overflow: hidden;
  color: #788579;
  font-size: 0.82rem;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.links-edit-account::before {
  display: inline-block;
  width: 0.5rem;
  height: 0.5rem;
  margin-right: 0.3rem;
  border-radius: 50%;
  background: var(--user-color, #789b73);
  content: "";
  vertical-align: 0.02rem;
}

.links-edit-project {
  flex: 0 0 auto;
  max-width: 40%;
  overflow: hidden;
  color: #49654a;
  text-overflow: ellipsis;
}

.links-edit-separator {
  flex: 0 0 auto;
  color: #788579;
}
.links-edit-separator::before {
  content: "·";
}

.links-edit-title {
  overflow: hidden;
  color: #35423a;
  text-overflow: ellipsis;
}

.links-controls {
  display: grid;
  gap: 0.5rem;
  padding: 0.35rem;
  border: 1px solid #dce4d7;
  border-radius: 12px;
  background: rgba(255, 254, 251, 0.94);
  box-shadow: 0 2px 8px rgba(54, 72, 54, 0.06);
}
.links-controls::before {
  content: "";
  position: absolute;
  z-index: 0;
  top: 0.35rem;
  right: 0.35rem;
  left: 0.35rem;
  height: calc((100% - 1.4rem) / 2);
  border: 1px solid #dce4d7;
  border-radius: 7px;
  background: #e6eee1;
  transform: translateY(calc(var(--mode) * (100% + 0.35rem)));
  transition: transform 240ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

.links-mode-button {
  position: relative;
  z-index: 1;
  min-width: 0;
  overflow: hidden;
  padding: 0.4rem 0.3rem;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: #788579;
  font: inherit;
  font-size: 0.76rem;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
  transition: color 150ms ease;
}
.links-mode-button:hover {
  color: #49654a;
}
.links-mode-button.active {
  color: #49654a;
  font-weight: 650;
}
.links-mode-button:focus-visible {
  border-radius: -2px;
  outline: 2px solid #789b73;
  outline-offset: 2px;
}

@media (max-width: 760px) {
  .links-page {
    grid-template-columns: minmax(5rem, 7rem) minmax(0, 1fr) minmax(5rem, 6.5rem);
    gap: 0.4rem;
  }
  .links-edit-row {
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 0.2rem;
  }
  .links-controls {
    padding: 0.3rem;
  }
  .links-mode-button {
    font-size: 0.65rem;
  }
}
@media (max-width: 460px) {
  .links-page {
    grid-template-columns: minmax(4rem, 5rem) minmax(0, 1fr) minmax(4rem, 5rem);
    gap: 0.2rem;
  }
  .link-item-header {
    padding: 0.6rem;
  }
  .links-edit-row {
    padding-right: 0.35rem;
    padding-left: 0.35rem;
  }
  .links-edit-meta,
  .links-edit-page {
    gap: 0.25rem;
  }
  .links-edit-timestamp,
  .links-edit-account,
  .links-edit-project,
  .links-edit-title {
    font-size: 0.68rem;
  }
}
@media (prefers-reduced-motion: reduce) {
  .links-controls::before,
  .link-chevron {
    transition: none;
    animation: none !important;
  }
}
